# Copy to .env and fill in. Never commit .env.
FRED_API_KEY=            # https://fred.stlouisfed.org/docs/api/api_key.html
ANTHROPIC_API_KEY=       # used by `make report` (narrative generation)
ANTHROPIC_WORKSPACE_ID=  # only if the key is an organisation-level key (console asks for a workspace header)
OWNER_EMAIL=danielconorsims@gmail.com
GMAIL_APP_PASSWORD=      # 16-character Gmail app password (Google Account -> Security -> App passwords)
GMAIL_USER=              # optional; defaults to OWNER_EMAIL
# Alternative: Gmail OAuth with credentials.json and token.json in .secrets/ (see docs/SETUP.md)
